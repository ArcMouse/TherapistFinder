# ──────────────────────────────────────────────────────────────
# MindEase environment variables
# Copy to `.env` (repo root) or `backend/.env` and fill in values.
# ──────────────────────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave blank to use the bundled SQLite database (local dev / tests).
# For production set a PostgreSQL URL with the `pgvector` extension enabled:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=
# DATABASE_URL=postgres://mindease:mindease@localhost:5432/mindease

# SimpleJWT
JWT_SIGNING_KEY=change-me-to-a-separate-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Demo password assigned to seeded therapist accounts (therapist portal login)
SEED_THERAPIST_PASSWORD=TherapistPass123

# Session reminders
SESSION_REMINDER_MINUTES=30
# console (dev) | django.core.mail.backends.filebased.EmailBackend (E2E) | smtp backend (prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FILE_PATH=backend/emails
DEFAULT_FROM_EMAIL=MindEase <no-reply@mindease.test>

# Google OAuth (backend ID-token verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth (mobile client, Expo inlines EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# CI/dev-only escape hatch: lets the Google button reach /api/auth/google/ without a consent screen.
# Never set this in production.
EXPO_PUBLIC_GOOGLE_DEV_TOKEN=

# Expo → API base URL
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Website (Vite) → API base URL
VITE_API_URL=http://localhost:8000/api

# Zoom (placeholder integration point; no live calls are made)
ZOOM_SDK_KEY=your-zoom-sdk-key
ZOOM_SDK_SECRET=your-zoom-sdk-secret

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# CORS
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=https://app.mindease.example